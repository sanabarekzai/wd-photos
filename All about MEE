<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>9 Photo Grid Album</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: Arial, sans-serif; background: #f5f5f5; padding: 20px; }
    .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; max-width: 1200px; margin: 0 auto; }
    .photo { cursor: pointer; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 8px rgba(0,0,0,0.1); background: #fff; }
    .photo img { width: 100%; height: 250px; object-fit: cover; display: block; }
    .photo-title { padding: 12px; text-align: center; font-weight: bold; font-size: 16px; }

    .modal { display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); }
    .modal-content { position: relative; margin: 5% auto; max-width: 800px; background: #fff; border-radius: 8px; overflow: hidden; }
    .modal-title { padding: 20px; text-align: center; font-size: 24px; font-weight: bold; background: #fff; }
    .modal-img { width: 100%; max-height: 60vh; object-fit: contain; display: block; }
    .modal-description { padding: 20px; text-align: center; font-size: 18px; background: #fff; }
    .close { position: absolute; top: 15px; right: 25px; font-size: 30px; font-weight: bold; color: #333; cursor: pointer; }
    .close:hover { color: #000; }
  </style>
</head>
<body>
  <div class="grid">
    <div class="photo" onclick="openModal(0)">
      <img src="https://static.vecteezy.com/system/resources/thumbnails/041/448/144/small/ai-generated-beautiful-landscape-scenery-nature-professionalgraphy-photo.jpg" alt="Dreamy place">
      <div class="photo-title">Dreamy place</div>
    </div>
    <div class="photo" onclick="openModal(1)">
      <img src="https://images.pexels.com/photos/36594706/pexels-photo-36594706.jpeg" alt="Cute cat">
      <div class="photo-title">Cute cat</div>
    </div>
    <div class="photo" onclick="openModal(2)">
      <img src="https://images.pexels.com/photos/36591054/pexels-photo-36591054.jpeg" alt="Cadillac">
      <div class="photo-title">Cadillac</div>
    </div>
    <div class="photo" onclick="openModal(3)">
      <img src="https://images.pexels.com/photos/30554306/pexels-photo-30554306.jpeg" alt="Dubai">
      <div class="photo-title">Dubai</div>
    </div>
    <div class="photo" onclick="openModal(4)">
      <img src="https://images.pexels.com/photos/30943345/pexels-photo-30943345.jpeg" alt="Pilot">
      <div class="photo-title">Pilot</div>
    </div>
    <div class="photo" onclick="openModal(5)">
      <img src="https://images.pexels.com/photos/27681035/pexels-photo-27681035.jpeg" alt="Hiking">
      <div class="photo-title">Hiking</div>
    </div>
    <div class="photo" onclick="openModal(6)">
      <img src="https://images.pexels.com/photos/32705658/pexels-photo-32705658.jpeg" alt="Mantu">
      <div class="photo-title">Mantu</div>
    </div>
    <div class="photo" onclick="openModal(7)">
      <img src="https://images.pexels.com/photos/27857312/pexels-photo-27857312.jpeg" alt="Basketball">
      <div class="photo-title">Basketball</div>
    </div>
    <div class="photo" onclick="openModal(8)">
      <img src="https://images.pexels.com/photos/34304261/pexels-photo-34304261.jpeg" alt="UCLA university">
      <div class="photo-title">UCLA university</div>
    </div>
  </div>

  <div id="myModal" class="modal">
    <div class="modal-content">
      <span class="close" onclick="closeModal()">&times;</span>
      <div class="modal-title" id="modalTitle"></div>
      <img id="modalImg" class="modal-img">
      <div class="modal-description" id="modalDescription"></div>
    </div>
  </div>

  <script>
    const photos = [
      { src: "https://static.vecteezy.com/system/resources/thumbnails/041/448/144/small/ai-generated-beautiful-landscape-scenery-nature-professionalgraphy-photo.jpg", title: "Dreamy place", description: "A landscape picture that makes me feel calm." },
      { src: "https://images.pexels.com/photos/36594706/pexels-photo-36594706.jpeg", title: "Cute cat", description: "my dream cat I want to have." },
      { src: "https://images.pexels.com/photos/36591054/pexels-photo-36591054.jpeg", title: "Cadillac", description: "My favorite car." },
      { src: "https://images.pexels.com/photos/30554306/pexels-photo-30554306.jpeg", title: "Dubai", description: "My favorite vocation place." },
      { src: "https://images.pexels.com/photos/30943345/pexels-photo-30943345.jpeg", title: "Pilot", description: "Dream job: flying planes." },
      { src: "https://images.pexels.com/photos/27681035/pexels-photo-27681035.jpeg", title: "Hiking", description: "my dream hobbie is to go hiking." },
      { src: "https://images.pexels.com/photos/32705658/pexels-photo-32705658.jpeg", title: "Mantu", description: "My favorite food is Mantu." },
      { src: "https://images.pexels.com/photos/27857312/pexels-photo-27857312.jpeg", title: "Basketball", description: "my favorite sport is basketball." },
      { src: "https://images.pexels.com/photos/34304261/pexels-photo-34304261.jpeg", title: "UCLA university", description: "my favorite university that I am planning to attend." }
    ];

    const modal = document.getElementById("myModal");
    const modalImg = document.getElementById("modalImg");
    const modalTitle = document.getElementById("modalTitle");
    const modalDescription = document.getElementById("modalDescription");

    function openModal(index) {
      modal.style.display = "block";
      modalImg.src = photos[index].src;
      modalTitle.textContent = photos[index].title;
      modalDescription.textContent = photos[index].description;
    }

    function closeModal() {
      modal.style.display = "none";
    }

    window.onclick = function(event) {
      if (event.target == modal) {
        closeModal();
      }
    }
  </script>
</body>
</html>
